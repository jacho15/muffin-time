# Copy to .env.local and fill in. Never commit real values.

# --- Browser (bundled into the SPA; the anon key is public by design, RLS protects data) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server-only (Vercel Functions in api/) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# api/cycle-notify.ts: daily cron + push notifications via ntfy.sh
CRON_SECRET=a-long-random-string
NTFY_TOPIC=your-private-ntfy-topic
CYCLE_TZ=America/Los_Angeles

# api/complaint.ts: feedback form emails via Resend
RESEND_API_KEY=re_your_resend_api_key
COMPLAINT_TO_EMAIL=you@example.com
COMPLAINT_FROM_EMAIL=Muffin Time <feedback@your-verified-domain.com>
